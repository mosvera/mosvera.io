{
  "version": "0.1.0",
  "default": "quiet-editorial",
  "aesthetics": [
    {
      "id": "quiet-editorial",
      "label": "Quiet Editorial",
      "summary": "A calm public-standard home: readable, measured, and institutional without feeling sterile.",
      "composition": {
        "$schema": "https://mosvera.io/schema/0.1/composition",
        "id": "quiet-editorial-site",
        "base": "public-standard",
        "modifiers": ["editorial-calm", "warm-canonical"],
        "overrides": {
          "surface": "documentation_site",
          "audience": "standards_adopters",
          "tone": "measured",
          "density": "comfortable"
        }
      },
      "canonical": {
        "palette": {
          "background": "#f7f2e7",
          "surface": "#fffaf0",
          "surface_alt": "#eee3d4",
          "ink": "#211b16",
          "muted": "#665c50",
          "accent": "#bd5838",
          "accent_2": "#2e6b5f",
          "border": "#d8c8b6",
          "code_bg": "#181513",
          "code_ink": "#f5ebdd"
        },
        "typography": {
          "display": "Fraunces",
          "body": "Hanken Grotesk",
          "mono": "IBM Plex Mono",
          "scale": "editorial"
        },
        "layout": {
          "density": "comfortable",
          "radius": "6px",
          "shadow": "0 18px 55px rgba(58, 38, 21, 0.16)",
          "max_width": "1160px"
        },
        "motion": {
          "pace": "steady",
          "duration": "220ms"
        },
        "imagery": {
          "treatment": "paper_field",
          "blend": "normal",
          "saturation": "0.92",
          "contrast": "1.02"
        },
        "voice": {
          "eyebrow": "Canonical public home",
          "headline": "Aesthetic infrastructure you can inspect.",
          "body": "Mosvera turns aesthetic intent into typed, portable, reviewable artifacts that teams can run inside their own platforms."
        }
      }
    },
